# ======================================
# 🌐 Express.js + MongoDB Backend .gitignore
# ======================================

# Node dependencies
node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep an example environment file (optional)
!.env.example

# Build / dist output
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
tmp/
temp/
*.tmp
*.temp

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Test coverage
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.eslintcache

# Uploaded or generated files
uploads/
public/uploads/
files/
storage/
generated/

# Database dumps / backups
*.bak
*.sql
*.sqlite
*.tar
dump/

# PM2 / nodemon / process IDs
pids/
*.pid
*.seed

# TypeScript (if used)
*.tsbuildinfo

# Optional lock files (comment out to include)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Misc
.env.backup
.env.bak
